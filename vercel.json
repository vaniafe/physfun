{
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/audio/:path*",
            "destination": "https://api.physfun.ru/storage/v1/object/public/message-audio/:path*"
        }
    ]
}
